{
  "name": "dynamic-island",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4731 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 4731 --strictPort",
    "start": "NODE_ENV=production node --experimental-strip-types server/index.mjs",
    "desktop": "electron --experimental-strip-types electron/main.mjs",
    "dist:win": "npm run build && electron-builder --win dir --publish never && node electron/trim.mjs && makensis electron/installer.nsi"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.79",
    "hls.js": "^1.7.4",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "bot.grok.dynamic-island",
    "productName": "Dynamic Island",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US",
      "ko"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "cursor/**/*",
      "desktop/release.json",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
